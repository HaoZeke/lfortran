; ModuleID = 'LFortran'
source_filename = "LFortran"
target datalayout = "..."

define void @a_() {
.entry:
  %"b~fpcast_ptr" = alloca void (float ()*, float ()*)*, align 8
  store void (float ()*, float ()*)* null, void (float ()*, float ()*)** %"b~fpcast_ptr", align 8
  store void (float ()*, float ()*)* bitcast (void ()* @b_ to void (float ()*, float ()*)*), void (float ()*, float ()*)** %"b~fpcast_ptr", align 8
  %0 = load void (float ()*, float ()*)*, void (float ()*, float ()*)** %"b~fpcast_ptr", align 8
  call void %0(float ()* @f_, float ()* @g_)
  br label %return

return:                                           ; preds = %.entry
  br label %FINALIZE_SYMTABLE_a_

FINALIZE_SYMTABLE_a_:                             ; preds = %return
  ret void
}

declare void @b_()

declare void @"b~fpcast_"(float ()*, float ()*)

declare void @"b~fpcast_ptr"(float ()*, float ()*)

declare float @f_()

declare float @g_()
