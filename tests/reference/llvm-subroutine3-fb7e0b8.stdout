; ModuleID = 'LFortran'
source_filename = "LFortran"
target datalayout = "..."

define i32 @f_() {
.entry:
  %f = alloca i32, align 4
  store i32 42, i32* %f, align 4
  br label %return

return:                                           ; preds = %.entry
  br label %FINALIZE_SYMTABLE_f_

FINALIZE_SYMTABLE_f_:                             ; preds = %return
  %0 = load i32, i32* %f, align 4
  ret i32 %0
}
