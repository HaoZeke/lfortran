/* Odd monoms for sin on [-pi/2, pi/2].
 * Blog (GSoC21 final report) used relative fpminimax on odd monoms.
 * prec=120 is stable; higher prec can fail to converge in Remez.
 * Run: sollya sin_odd.sollya
 */
prec = 120;
display = decimal;
Psin = fpminimax(sin(x), [|1,3,5,7,9,11,13,15|], [|1,D...|], [-pi/2;pi/2], relative, fixed);
print("Psin = ", Psin);
print("supnorm_rel = ", supnorm(Psin, sin(x), [-pi/2;pi/2], relative, 2^(-40)));
for i from 0 to 7 do {
  print("S", i, " = ", round(coeff(Psin, 2*i+1), D, RN), "_dp");
};
